<div class="col-12"><div class="form-group" data-mis-field role="group" aria-labelledby="frm-form-checkboxlist-label"><div id="frm-form-checkboxlist-label" class="form-label">Checklist</div><div class="vstack gap-2"><div class="form-field form-field-card"><input type="checkbox" name="checkboxlist[]" id="frm-form-checkboxlist-first" value="first" class="check"><div class="form-field-content"><label for="frm-form-checkboxlist-first"><span class="me-2"><i class="bi bi-user" aria-hidden="true"></i></span>First</label><small class="form-text">Description</small></div></div><div class="form-field form-field-card"><input type="checkbox" name="checkboxlist[]" id="frm-form-checkboxlist-second" value="second" class="check"><label for="frm-form-checkboxlist-second">Second</label></div></div></div></div>