<div class="col-12"><div class="form-field" data-mis-field><label for="frm-form-slider" class="form-label">Slider</label><div class="form-range" data-mis-range-items='["2020","2021","2022"]' data-bs-bubble><input type="range" name="slider" id="frm-form-slider" value="0" min="0" max="2" step="1" list="frm-form-slider-ticks" class="form-range-input"></div><datalist id="frm-form-slider-ticks"><option value="0" label="2020"></option><option value="1" label="2021"></option><option value="2" label="2022"></option></datalist></div></div>