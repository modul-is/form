<div class="col-12" id="customId"><div class="form-field" data-mis-field><label for="frm-form-slider" class="form-label">Slider</label><div class="form-range" data-bs-bubble><input type="range" name="slider" id="frm-form-slider" value="0" min="0" max="100" step="5" list="frm-form-slider-ticks" class="form-range-input"></div><datalist id="frm-form-slider-ticks"><option value="0" label="0"></option><option value="5"></option><option value="10"></option><option value="15"></option><option value="20"></option><option value="25"></option><option value="30"></option><option value="35"></option><option value="40"></option><option value="45"></option><option value="50"></option><option value="55"></option><option value="60"></option><option value="65"></option><option value="70"></option><option value="75"></option><option value="80"></option><option value="85"></option><option value="90"></option><option value="95"></option><option value="100" label="100"></option></datalist></div></div>