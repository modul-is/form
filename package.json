			"optional": true
		}
	},
	"devDependencies": {
		"bootstrap": "6.0.0-alpha.1",
		"bootstrap-icons": "^1.13.1",
		"naja": "^3.3.0",
		"nette-forms": "^3.5.3",
		"vite": "^8.3.5"
	},
