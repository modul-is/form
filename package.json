{
	"name": "@modul-is/form",
	"version": "0.0.0",
	"private": true,
	"description": "Client side of modul-is/form - Nette forms rendered for Bootstrap 6",
	"keywords": [
		"nette",
		"nette-forms",
		"forms",
		"bootstrap",
		"bootstrap6"
	],
	"license": "MIT",
	"homepage": "https://github.com/modul-is/form",
	"repository": {
