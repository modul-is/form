extensions:
	modulisForm: ModulIS\Form\DI\FormExtension

application:
	mapping: ModulIS\Form\Demo\*Module\Presenter\*Presenter

latte:
	strictTypes: true

modulisForm:
	currency: CZK

services:
	router:
		create: Nette\Application\Routers\RouteList
		setup:
			- addRoute('<presenter>/<action>', 'Demo:default')
