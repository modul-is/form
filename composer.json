{
	"name": "modul-is/form",
	"type": "library",
	"description": "Simplified nette forms rendered for Bootstrap 6",
	"keywords": ["php", "nette", "form", "bootstrap", "bs6"],
	"homepage": "https://github.com/modul-is/form",
	"license": "MIT",
    "require":
    {
		"php": "^8.4",
		"nette/utils": "^4.0",
		"nette/forms": "^3.3.0",
		"nette/application": "^3.0 || ^4.0"
    },
    "require-dev":
    {
		"phpstan/phpstan-nette": "^2",
		"modul-is/coding-standard": "^5",
		"nette/tester": "^2.1",
		"nette/bootstrap": "^3.2",
		"nette/di": "^3.2",
		"tracy/tracy": "^2.10",
		"latte/latte": "^3.1"
    },
    "autoload":
    {
		"classmap": ["src/"]
    },
    "autoload-dev":
    {
		"classmap": ["demo/app/"]
    },
    "config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
